DATABASE_URL="postgresql://forgeai:forgeai@localhost:5434/forgeai?schema=public"
# On a pooled host (Neon, Supabase, PgBouncer) set DIRECT_URL to the
# non-pooled connection string — migrations need it. For local/unpooled
# Postgres, just repeat DATABASE_URL here.
DIRECT_URL="postgresql://forgeai:forgeai@localhost:5434/forgeai?schema=public"
SESSION_SECRET="change-me-in-production"
